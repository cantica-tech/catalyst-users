# Copy to deploy/.env (never committed) and edit. No secret belongs here: those are files in deploy/secrets/.

# The URL users and catalyst reach Keycloak at, behind your TLS-terminating reverse proxy.
KC_HOSTNAME=https://id.example.com
KEYCLOAK_VERSION=26.4.0
KC_HTTP_PORT=8080
KC_MANAGEMENT_PORT=9000
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# catalyst's first admin: the realm's catalyst-admin and the provisioning container's system account.
CATALYST_ADMIN=ada
CATALYST_ADMIN_EMAIL=ada@example.com
CATALYST_ADMIN_FIRST_NAME=Ada
CATALYST_ADMIN_LAST_NAME=Lovelace

# The criteria to create, space-separated: catalyst deployments' project names (catalyst.toml's project_name).
CATALYST_CRITERIA=
